# Dependencies: installed by npm from package.json, never committed
node_modules/

# Environment files: will hold secrets (Postgres password, token signing key).
# .env.example is the one exception: a committed template with no real values.
.env
.env.*
!.env.example

# Build output
dist/
*.tsbuildinfo

# Expo (apps/mobile). Leading-slash paths are anchored to this file's folder,
# so they must spell out the full path from the repo root.
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile/example/

# Native signing keys and credentials
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# OS files
.DS_Store